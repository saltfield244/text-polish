<Project Sdk="Microsoft.NET.Sdk">

  <!-- 回帰テスト。外部NuGetパッケージ(xUnit等)を増やさない方針のため、
       テストランナーも含めて自前の小さなコンソールアプリにしている。
       実行方法は src/TextPolish.Tests/README.md を参照。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TextPolish.Tests</RootNamespace>
    <AssemblyName>TextPolish.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextPolish.Core\TextPolish.Core.csproj" />
  </ItemGroup>

</Project>
