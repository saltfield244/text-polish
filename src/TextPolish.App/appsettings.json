{
  // "AzureOpenAI" / "Gemini" / "OpenAiCompatible" のいずれかを指定する。設定画面からも切り替え可能。
  "LlmProvider": "OpenAiCompatible",

  // LLM呼び出しのタイムアウト(秒)。変更後はアプリの再起動が必要。
  // ReasoningEffort を上げると応答が伸びるため、必要に応じて延ばす。
  "RequestTimeoutSeconds": 120,

  // OpenAI互換のChat Completions API(OpenRouter / OpenAI本家 / ローカルサーバー等)。
  // Azure OpenAIとはURL形式・認証方式が異なるため設定を分けている。
  "OpenAiCompatible": {
    "Endpoint": "https://openrouter.ai/api/v1/chat/completions",
    // TODO: APIキーを設定する(設定画面からも入力できます)。平文保存は開発用の暫定対応。
    "ApiKey": "TODO-api-key",
    // TODO: 使用するモデルを設定する(例: "openai/gpt-4o-mini")
    "Model": "TODO-model",
    // OpenRouterのランキング表示用の任意ヘッダー。不要ならnullのままでよい。
    "SiteUrl": null,
    "AppTitle": "TextPolish",

    // 以下はGPT-5系(推論モデル)向けの任意パラメータ。null なら送信しないため、
    // 対応していないモデルを使う場合は null のままにしておく。
    // "minimal" / "low" / "medium" / "high"
    "ReasoningEffort": null,
    // "low" / "medium" / "high"。整形結果だけを返させるため "low" が適する。
    "Verbosity": null,
    // 出力トークン上限。推論トークンもここから消費されるので、応答が空になるなら増やす。
    "MaxCompletionTokens": null
  },

  "AzureOpenAI": {
    // TODO: 実リソースのエンドポイントに置き換える(例: https://{resource}.openai.azure.com)
    "Endpoint": "https://TODO-your-resource.openai.azure.com",
    "ApiKey": "TODO-azure-openai-api-key",
    // TODO: Azureでモデルをデプロイした際に付けたデプロイ名
    "Deployment": "TODO-deployment-name",
    "ApiVersion": "2024-06-01",

    // 以下はGPT-5系(推論モデル)向けの任意パラメータ。null なら送信しない。
    "ReasoningEffort": null,
    "Verbosity": null,
    "MaxCompletionTokens": null
  },

  "Gemini": {
    // TODO: Vertex AI経由かGoogle AI Studio経由かで Endpoint / AuthMode が変わる。
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/models/TODO-model:generateContent",
    "ApiKey": "TODO-gemini-api-key",
    "Model": "TODO-model",
    // "ApiKeyQueryParam"(AI Studio想定) または "BearerToken"(Vertex AI想定)
    "AuthMode": "ApiKeyQueryParam"
  },

  // 選択テキストの整形パレット。
  "Polish": {
    "Enabled": true,
    // 指定したキーは他のアプリへ渡らなくなる点に注意。
    "Hotkey": "F10",
    "SystemPromptFilePath": "PolishSystemPrompt.txt",

    // 用語辞書。「誤変換されがちな表記 → 正しい表記」を1行1組で書く。
    // ファイルがなければ辞書なしとして動作する。整形のたびに読み直すため再起動は不要。
    "GlossaryFilePath": "Glossary.txt",

    // 整形結果を差分ハイライトで表示するかどうかの初期値。
    // パレット上の「差分表示」チェックでいつでも切り替えられる。
    // 翻訳のように原文がほとんど残らない場合は、この値に関わらず初期状態では表示しない。
    "ShowDiffByDefault": true,

    // パレットを出さずに、その場で整形して置き換えるホットキー。
    // 空にすると無効。Hotkey と同じキーは指定できない(起動時に無効化される)。
    // 確認を挟まないので、取り消しは貼り付け先で Ctrl+Z。
    "QuickHotkey": "",
    // 即実行で使うプリセット名。見つからない場合は先頭のプリセットが使われる。
    "QuickPresetName": "整える"
    // Presets は未指定の場合、既定の7つ
    // (整える / 誤変換だけ直す / ビジネスメール / チャット / 要約 / 英訳 / 和訳)が使われる。
    // 設定画面で一度「保存」すると、既定値がこのファイルに書き出され編集できるようになる。
    // 各プリセットの Group は排他グループ。同じ値のもの同士はパレットで同時に選べない
    // (Style=文体の指定 / Length=要約 / Translate=翻訳)。空にすると何とでも組み合わせ可能になる。
    // 複数選んだときは Presets の並び順に適用されるため、翻訳は末尾に置くこと。
  },

  // テキスト挿入(クリップボード+Ctrl+V)の挙動。
  "TextInsertion": {
    "RestoreClipboard": true,
    // 貼り付け先が遅い環境で誤挿入が起きる場合は値を大きくする。
    "RestoreDelayMs": 800
  }
}
