<Window x:Class="TextPolish.App.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整形"
        Height="440" Width="520"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="選択中のテキスト" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="OriginalTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#F5F5F5"/>

        <TextBlock Grid.Row="2" Text="整形方法(複数選べます。上から順に適用されます)"
                   FontWeight="Bold" Margin="0,12,0,4"/>
        <WrapPanel Grid.Row="3" x:Name="PresetPanel"/>

        <TextBlock Grid.Row="4" Text="自由指示(任意。選んだ整形のあとに適用されます)"
                   FontWeight="Bold" Margin="0,12,0,4"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="InstructionBox" IsEditable="True"
                      StaysOpenOnEdit="True" KeyDown="InstructionBox_KeyDown"/>
            <Button Grid.Column="1" x:Name="RunButton" Content="実行" Width="80" Margin="8,0,0,0"
                    Click="RunButton_Click"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <CheckBox x:Name="ShowDiffCheckBox" Content="差分表示" DockPanel.Dock="Right"
                          VerticalAlignment="Center" IsEnabled="False"
                          Click="ShowDiffCheckBox_Click"/>
                <TextBlock x:Name="ResultLabel" Text="整形結果(編集できます)" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBox Grid.Row="1" x:Name="ResultTextBox" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

            <ScrollViewer Grid.Row="1" x:Name="DiffScroll" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Background="#FAFAFA"
                          BorderBrush="#ABADB3" BorderThickness="1" Padding="4,2,4,2">
                <TextBlock x:Name="DiffTextBlock" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="7" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Content="置き換える" Width="110" Margin="0,0,8,0"
                        IsEnabled="False" Click="ApplyButton_Click"/>
                <Button x:Name="CloseButton" Content="キャンセル" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
